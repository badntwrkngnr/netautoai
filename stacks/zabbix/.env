# PostgreSQL credentials, shared by zabbix-db and zabbix-server/web
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=changeme
POSTGRES_DB=zabbix
DB_SERVER_HOST=zabbix-db

# Zabbix server
ZBX_SERVER_HOST=zabbix-server
ZBX_ENABLE_SNMP_TRAPS=true

# Zabbix server cache sizing -- tune for your VM's RAM
ZBX_CACHESIZE=128M
ZBX_HISTORYCACHESIZE=64M
ZBX_TRENDCACHESIZE=32M
ZBX_STARTPOLLERS=10
ZBX_STARTPINGERS=5
ZBX_STARTTRAPPERS=5
ZBX_STARTSNMPTRAPPER=1
