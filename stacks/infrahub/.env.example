# Copy to .env and fill in real values before running docker compose.
# Exact variable names depend on the Infrahub version -- after running
# fetch-base-compose.sh, grep the downloaded docker-compose.yml for
# ${VAR_NAME...} references and mirror any you want to override here.

INFRAHUB_SECURITY_SECRET_KEY=changeme
INFRAHUB_DB_PASSWORD=changeme
INFRAHUB_INITIAL_ADMIN_PASSWORD=changeme
INFRAHUB_INITIAL_ADMIN_TOKEN=changeme
