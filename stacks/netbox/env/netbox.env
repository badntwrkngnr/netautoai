# --- Superuser (created on first run) ---
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=changeme
SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567

# --- Database ---
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=changeme

# --- Redis (tasks/webhooks) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DATABASE=0

# --- Redis (caching) ---
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=changeme
REDIS_CACHE_DATABASE=1

# --- Django ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme-needs-50-characters-minimum-xxxxxxxxxxxxxxx
ALLOWED_HOSTS=*
