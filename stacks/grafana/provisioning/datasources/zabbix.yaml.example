# Rename to zabbix.yaml (drop .example) once Zabbix is up and you have an
# API user/password ready. Grafana auto-loads files from this directory.

apiVersion: 1

datasources:
  - name: Zabbix
    type: alexanderzobnin-zabbix-datasource
    access: proxy
    url: http://zabbix-web:8080/api_jsonrpc.php
    jsonData:
      username: Admin
      trends: true
      trendsFrom: "7d"
      trendsRange: "4d"
    secureJsonData:
      password: changeme
    isDefault: true
    editable: true
